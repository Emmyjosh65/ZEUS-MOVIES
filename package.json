{
  "name": "zeus-netflix",
  "version": "1.0.0",
  "description": "ZEUS NETFLIX Desktop App",
  "author": {
    "name": "EmmyJosh65",
    "email": "ge5853987@gmail.com"
  },
  "license": "MIT",
  "main": "index.js",
  "private": true,

  "scripts": {
    "dev": "vite build --watch",
    "start": "vite build && electron .",
    "dist": "cross-env ELECTRON_DIST=1 vite build && npm run dist:linux && npm run dist:win && npm run dist:mac",
    "dist:linux": "cross-env ELECTRON_DIST=1 vite build && electron-builder --linux deb AppImage pacman --publish never",
    "dist:deb": "cross-env ELECTRON_DIST=1 vite build && electron-builder --linux deb --publish never",
    "dist:arch": "cross-env ELECTRON_DIST=1 vite build && electron-builder --linux pacman --publish never",
    "dist:appimage": "cross-env ELECTRON_DIST=1 vite build && electron-builder --linux AppImage --publish never",
    "dist:win": "cross-env ELECTRON_DIST=1 vite build && electron-builder --win --publish never",
    "dist:mac": "cross-env ELECTRON_DIST=1 vite build && electron-builder --mac --universal --publish never"
  },

  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },

  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^7.0.3",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "terser": "^5.46.0",
    "vite": "^7.3.1"
  },

  "build": {
    "appId": "com.zeus.netflix",
    "productName": "ZEUS NETFLIX",

    "asar": true,
    "compression": "normal",

    "directories": {
      "buildResources": "build"
    },

    "files": [
      "dist/**/*",
      "src/ipc/**/*",
      "index.js",
      "preload.js",
      "package.json"
    ],

    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createStartMenuShortcut": true,
      "selectPerMachineByDefault": false,
      "license": "LICENSE",
      "uninstallDisplayName": "Uninstall ZEUS NETFLIX",
      "installerSidebar": "public/installer-sidebar.bmp"
    },

    "win": {
      "icon": "public/icon.png",
      "target": [
        "nsis"
      ]
    },

    "mac": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.entertainment"
    },

    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],

      "category": "AudioVideo",

      "icon": "public/sized",

      "desktop": {
        "entry": {
          "Name": "ZEUS NETFLIX",
          "Comment": "ZEUS NETFLIX Desktop App",
          "Categories": "AudioVideo;Video;Player;Entertainment;",
          "Icon": "zeus-netflix",
          "StartupWMClass": "ZEUS NETFLIX"
        }
      }
    }
  }
}
